NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Optional: only needed for npm run db:migrate (keep real value in .env.local, never commit it)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Prefer applying only the OCR migration if older migrations were already applied manually:
# DATABASE_URL=... npm run db:migrate -- --only 20260919150000_notes_ocr_text.sql

# Server-only whole-roll AI insight controls (never NEXT_PUBLIC_*).
# AI stays off unless AI_ANALYSIS_ENABLED is exactly true or 1.
# AI_ANALYSIS_ENABLED=false
# AI_MAX_FRAMES=36
# AI_MAX_IMAGE_BYTES=1500000
# AI_DAILY_CALL_CAP=50
